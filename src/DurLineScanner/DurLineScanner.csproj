<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-SDK-Version wird für die WinRT-Bluetooth-LE-APIs benötigt -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>DurLine Scanner</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent-Theme (Application.ThemeMode) ist in .NET noch als experimentell markiert -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <!-- Programmsymbol: Sat-Schüssel mit Signalbögen in Ampelfarben -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DurLineScanner.Tests" />
  </ItemGroup>

</Project>
