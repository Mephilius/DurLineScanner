<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-SDK-Version wird für die WinRT-Bluetooth-LE-APIs benötigt -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>DUR-line Scanner</AssemblyTitle>
    <!-- Lokale Builds; der Release-Workflow setzt die Version aus dem Tag (-p:Version=…) -->
    <Version>0.0.0-dev</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent-Theme (Application.ThemeMode) ist in .NET noch als experimentell markiert -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <!-- Programmsymbol: Sat-Schüssel mit Signalbögen in Ampelfarben -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hilfe: Handbücher und Lizenz sind ins Programm eingebettet und passen so immer zur Version -->
    <EmbeddedResource Include="..\..\docs\BENUTZERHANDBUCH.md" LogicalName="Help.BENUTZERHANDBUCH.md" />
    <EmbeddedResource Include="..\..\docs\USER_GUIDE.md" LogicalName="Help.USER_GUIDE.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Help.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DurLineScanner.Tests" />
  </ItemGroup>

</Project>
