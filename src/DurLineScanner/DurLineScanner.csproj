<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK version is required for the WinRT Bluetooth LE APIs -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>DUR-line Scanner</AssemblyTitle>
    <!-- Local builds; the release workflow sets the version from the tag (-p:Version=…) -->
    <Version>0.0.0-dev</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent theme (Application.ThemeMode) is still marked experimental in .NET -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon: satellite dish with signal arcs in traffic light colors -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help: user guides and license are embedded in the app so they always match the version -->
    <EmbeddedResource Include="..\..\docs\BENUTZERHANDBUCH.md" LogicalName="Help.BENUTZERHANDBUCH.md" />
    <EmbeddedResource Include="..\..\docs\USER_GUIDE.md" LogicalName="Help.USER_GUIDE.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Help.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DurLineScanner.Tests" />
  </ItemGroup>

</Project>
