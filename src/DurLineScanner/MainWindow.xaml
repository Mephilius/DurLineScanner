<Window x:Class="DurLineScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:c="clr-namespace:DurLineScanner.Controls"
        xmlns:l="clr-namespace:DurLineScanner.Localization"
        Title="DUR-line Scanner" Height="920" Width="1480" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI" FontSize="13" Icon="/Assets/app.ico">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Titel und Gerät -->
        <Grid Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" Content="⚙  Einstellungen" Click="SettingsButton_Click" Margin="10,0,0,0"
                    VerticalAlignment="Center" ToolTip="Standorte verwalten, Receiver für die Senderliste eintragen" />
            <Button Grid.Column="3" Content="?  Hilfe" Click="HelpButton_Click" Margin="8,0,0,0"
                    VerticalAlignment="Center" ToolTip="Benutzerhandbuch, Version und Lizenz (F1)" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DUR-line Scanner" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                <TextBlock Text="Sat-Messung mit dem SF 4000 BT" Style="{StaticResource Hint}"
                           VerticalAlignment="Bottom" Margin="12,0,0,3" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#B0B0B0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConnectionText" Text="nicht verbunden" VerticalAlignment="Center"
                               Margin="8,0,14,0" MinWidth="170" />
                    <Button x:Name="ConnectButton" Content="Verbinden" Click="ConnectButton_Click"
                            Style="{StaticResource AccentButton}" MinWidth="100" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Messung einrichten -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- erste Zeile: Bedingungen -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Standort" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="…" Click="ManageSitesButton_Click" Margin="6,0,0,0" MinWidth="34"
                                ToolTip="Standorte verwalten: Adresse, Koordinaten, Schüsselgröße, LNB" />
                        <ComboBox x:Name="SiteBox" SelectionChanged="SiteBox_SelectionChanged"
                                  ToolTip="Standort mit Schüsselgröße und LNB – wird mit dem Scan gespeichert und für die Ampel verwendet" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Wetter jetzt" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="WeatherBox" SelectionChanged="WeatherBox_SelectionChanged"
                              ToolTip="Wird mit dem Scan gespeichert – so lassen sich Scans bei gleichem Wetter vergleichen" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Satellit" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SatelliteBox" SelectionChanged="SatelliteBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Notiz (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NoteBox" ToolTip="z.B. „vor dem Ausrichten“ – erscheint in der Liste der Messreihen" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="ScanButton" Content="▶  Scan starten" Click="ScanButton_Click" IsEnabled="False"
                            Style="{StaticResource AccentButton}" MinWidth="130" Margin="0,0,8,0" />
                    <Button x:Name="StopButton" Content="■  Stopp" Click="StopButton_Click" IsEnabled="False" MinWidth="80" />
                </StackPanel>

                <!-- zweite Zeile: Messort -->
                <StackPanel Grid.Row="1" Margin="0,10,12,0">
                    <TextBlock Text="Messort" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="LocationKindBox" SelectedIndex="0" SelectionChanged="LocationKindBox_SelectionChanged">
                        <ComboBoxItem Content="Sat-Dose (Wohnung)" />
                        <ComboBoxItem Content="LNB-Port (an der Schüssel)" />
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="RoomPanel" Grid.Row="1" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Raum" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="RoomBox" IsEditable="True"
                              ToolTip="Raum wählen oder eigenen Namen eintippen – bereits gemessene Räume stehen oben" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock x:Name="OutletLabel" Text="Anschluss im Raum" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="OutletBox" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,10,12,0">
                    <TextBlock x:Name="PlaneLabel" Text="Ebenen" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PlaneFilterBox" SelectedIndex="0"
                              ToolTip="Bei einem Quattro-LNB führt jeder Port fest eine Ebene – dann nur diese scannen">
                        <ComboBoxItem Content="alle" />
                        <ComboBoxItem Content="Low V" />
                        <ComboBoxItem Content="Low H" />
                        <ComboBoxItem Content="High V" />
                        <ComboBoxItem Content="High H" />
                    </ComboBox>
                </StackPanel>

                <!-- dritte Zeile: Fortschritt, Transponder- und Senderliste -->
                <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ProgressBar x:Name="ScanProgress" Width="220" Height="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="ListSourceText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="UpdateListButton" Content="⟳  Transponderliste aktualisieren" Click="UpdateListButton_Click"
                                ToolTip="Lädt die aktuelle satellites.xml von OpenPLi (aus LyngSat erzeugt)" Margin="0,0,8,0" />
                        <Button Content="Aus Datei …" Click="ImportListButton_Click" Margin="0,0,16,0"
                                ToolTip="satellites.xml vom eigenen Receiver übernehmen (/etc/tuxbox/satellites.xml)" />
                        <TextBlock x:Name="ChannelSourceText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="ReceiverButton" Content="⟳  Vom Receiver" Click="ReceiverButton_Click" Margin="0,0,8,0"
                                ToolTip="Senderliste online vom Enigma2-Receiver oder TVHeadend laden (in den Einstellungen eintragen)" />
                        <Button Content="lamedb-Datei …" Click="ImportChannelsButton_Click"
                                ToolTip="Enigma2-lamedb (/etc/enigma2/lamedb oder lamedb5) oder ein Senderlisten-Paket (ZIP) laden – zeigt die Programme je Transponder" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Inhalt -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Messreihen -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Messreihen" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Auswählen = anzeigen · Häkchen = zum Vergleich einblenden" />
                    <ComboBox x:Name="SessionFilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                              SelectionChanged="SessionFilterBox_SelectionChanged" ToolTip="Messreihen nach Messort filtern" />
                    <ComboBox x:Name="WeatherFilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                              SelectionChanged="SessionFilterBox_SelectionChanged" ToolTip="Messreihen nach Wetter filtern – Scans bei gleichem Wetter vergleichen" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                        <Button Content="📦  Exportieren …" Click="ExportSiteButton_Click" Margin="0,0,3,0"
                                ToolTip="Standort (oben gewählt) mit allen seinen Messreihen als ZIP speichern – JSON zum Wiedereinlesen und CSV für Excel" />
                        <Button Content="Importieren …" Click="ImportSiteButton_Click" Margin="3,0,0,0"
                                ToolTip="Standort-ZIP einlesen: Standort und Messreihen werden übernommen, vorhandene nicht doppelt" />
                    </UniformGrid>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                        <Button Content="CSV-Export" Click="ExportButton_Click" Margin="0,0,4,0" />
                        <Button Content="Löschen" Click="DeleteButton_Click" Margin="2,0,2,0" />
                        <Button Content="Ordner" Click="OpenFolderButton_Click" Margin="4,0,0,0" ToolTip="Speicherordner öffnen" />
                    </UniformGrid>
                    <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompared}" Checked="CompareChanged" Unchecked="CompareChanged"
                                              VerticalAlignment="Top" ToolTip="{l:T 'Zum Vergleich einblenden'}" MinWidth="0" Margin="0,0,6,0" />
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding LightBrush}" ToolTip="{Binding Verdict.Headline}" />
                                            <TextBlock Text="{Binding Session.LocationLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" />
                                        <TextBlock Text="{Binding Conditions}" Style="{StaticResource Hint}" />
                                        <TextBlock Text="{Binding Session.Note}" Style="{StaticResource Hint}" FontStyle="Italic" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="6">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem x:Name="OverviewTab" Header="Übersicht">
                        <DockPanel Margin="6">
                            <c:TrafficLight x:Name="ScanLight" DockPanel.Dock="Top" Margin="0,4,0,6" VisibleReasons="4" />
                            <Grid DockPanel.Dock="Top" Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Messwert" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="MetricBox" Width="170" SelectedIndex="0" SelectionChanged="MetricBox_SelectionChanged">
                                        <ComboBoxItem Content="MER (dB)" />
                                        <ComboBoxItem Content="C/N (dB)" />
                                        <ComboBoxItem Content="Pegel (dBµV)" />
                                        <ComboBoxItem Content="Qualität (%)" />
                                        <ComboBoxItem Content="Stärke (%)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="LegendPanel" Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <sp:WpfPlot x:Name="PlotH" />
                                <sp:WpfPlot x:Name="PlotV" Grid.Row="1" />
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Ebenen &amp; Pegel">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8">
                                Auswertung der vier ZF-Ebenen über alle Transponder mit Lock. Die Ebenen sollten auf wenige dB gleich sein;
                                die Schräglage zeigt die Kabeldämpfung über die Frequenz. Der Pegel des SF 4000 ist nicht kalibriert –
                                Vergleiche sind aussagekräftiger als Absolutwerte.
                            </TextBlock>
                            <DataGrid x:Name="PlaneGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,8" GridLinesVisibility="Horizontal">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Background" Value="{StaticResource WarningRow}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Hint">
                                                <Setter Property="Background" Value="{StaticResource HintRow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ebene" Binding="{Binding PlaneName}" />
                                    <DataGridTextColumn Header="Lock" Binding="{Binding Locked}" />
                                    <DataGridTextColumn Header="von" Binding="{Binding Total}" />
                                    <DataGridTextColumn Header="Pegel Ø" Binding="{Binding LevelMean}" />
                                    <DataGridTextColumn Header="min" Binding="{Binding LevelMin}" />
                                    <DataGridTextColumn Header="max" Binding="{Binding LevelMax}" />
                                    <DataGridTextColumn Header="Abw. Median dB" Binding="{Binding DeviationFromOthers}" />
                                    <DataGridTextColumn Header="Schräglage dB/100 MHz" Binding="{Binding SlopeDbPer100MHz}" />
                                    <DataGridTextColumn Header="MER Ø" Binding="{Binding MerMean}" />
                                    <DataGridTextColumn Header="Bewertung" Binding="{Binding Assessment}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <sp:WpfPlot x:Name="PlotPlanes" Grid.Row="2" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Vergleich">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="Gleiche Bedingungen ankreuzen" Click="SameConditionsButton_Click" Margin="12,0,0,0"
                                        ToolTip="Hakt alle Messreihen mit demselben Standort, Satelliten und Wetter wie die angezeigte an" />
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="Angezeigte Messreihe plus alle mit Häkchen – z.B. LNB-Ports gegen Dosen: Was am Port ankommt und an der Dose fehlt, geht im Verteilnetz verloren. Für faire Vergleiche gleiches Wetter wählen." />
                            </DockPanel>
                            <DataGrid x:Name="CompareGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,8" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Messort" Binding="{Binding Location}" />
                                    <DataGridTextColumn Header="Datum" Binding="{Binding Started, StringFormat=dd.MM.yy HH:mm}" />
                                    <DataGridTextColumn Header="Standort" Binding="{Binding Site}" />
                                    <DataGridTextColumn Header="Wetter" Binding="{Binding Weather}" />
                                    <DataGridTextColumn Header="Ampel" Binding="{Binding Light}" />
                                    <DataGridTextColumn Header="Lock" Binding="{Binding LockText}" />
                                    <DataGridTextColumn Header="Löcher" Binding="{Binding Holes}" />
                                    <DataGridTextColumn Header="Low V Ø" Binding="{Binding LowV}" />
                                    <DataGridTextColumn Header="Low H Ø" Binding="{Binding LowH}" />
                                    <DataGridTextColumn Header="High V Ø" Binding="{Binding HighV}" />
                                    <DataGridTextColumn Header="High H Ø" Binding="{Binding HighH}" />
                                    <DataGridTextColumn Header="MER Ø" Binding="{Binding Mer}" />
                                    <DataGridTextColumn Header="Hinweise" Binding="{Binding Notes}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <sp:WpfPlot x:Name="PlotCompare" Grid.Row="2" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Tabelle">
                        <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="6"
                                  HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Locked}" Value="False" />
                                                <Condition Binding="{Binding ProbablyInactive}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource WarningRow}" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding ProbablyInactive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Resources>
                                <!-- Beim Überfahren der Transponderspalten die Programme anzeigen -->
                                <Style x:Key="TransponderCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="ToolTip" Value=" " />
                                    <Setter Property="ToolTipService.ShowDuration" Value="2147483647" />
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
                                    <EventSetter Event="ToolTipOpening" Handler="TransponderCell_ToolTipOpening" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Frequenz" Binding="{Binding FrequencyMHz}" CellStyle="{StaticResource TransponderCell}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Pol" Binding="{Binding PolarizationShort}" CellStyle="{StaticResource TransponderCell}" />
                                <DataGridTextColumn Header="SR" Binding="{Binding SymbolRateKs}" CellStyle="{StaticResource TransponderCell}" />
                                <DataGridTextColumn Header="Modulation" Binding="{Binding ModulationText}" CellStyle="{StaticResource TransponderCell}" />
                                <DataGridTextColumn Header="Band" Binding="{Binding Band}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding LockText}" />
                                <DataGridTemplateColumn x:Name="ColMer" Header="MER dB" Width="170" SortMemberPath="MerDb">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:DataBar Value="{Binding MerDb}" Maximum="20" Margin="4,0"
                                                       Fill="{Binding MerGrade, Converter={x:Static c:GradeBrushConverter.Instance}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColMargin" Header="Reserve dB" Binding="{Binding MerMargin, StringFormat=+0.0;-0.0}" />
                                <DataGridTemplateColumn x:Name="ColGrade" Header="Bewertung" SortMemberPath="MerGrade">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="8,1" HorizontalAlignment="Left"
                                                    Background="{Binding MerGrade, Converter={x:Static c:GradeBrushConverter.Instance}}">
                                                <TextBlock Text="{Binding MerGrade, Converter={x:Static c:GradeTextConverter.Instance}}"
                                                           Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColLevel" Header="Pegel dBµV" Width="170" SortMemberPath="LevelDbuV">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:DataBar Value="{Binding LevelDbuV}" Minimum="30" Maximum="90" Margin="4,0"
                                                       Fill="{Binding LevelGrade, Converter={x:Static c:GradeBrushConverter.Instance}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColQuality" Header="Qualität %" Width="150" SortMemberPath="QualityPercent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <c:DataBar Value="{Binding QualityPercent}" Maximum="100" Margin="4,0"
                                                       Fill="{Binding QualityGrade, Converter={x:Static c:GradeBrushConverter.Instance}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColCn" Header="C/N dB" Binding="{Binding CnDb}" />
                                <DataGridTextColumn x:Name="ColStrength" Header="Stärke %" Binding="{Binding StrengthPercent}" />
                                <DataGridTextColumn x:Name="ColBer" Header="BER" Binding="{Binding Ber, StringFormat=0.0E+0}" />
                                <DataGridTextColumn Header="Lock-Zeit s" Binding="{Binding LockTimeSeconds, StringFormat=0.0}" />
                                <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem x:Name="LiveTab" Header="Live-Messung">
                        <DockPanel x:Name="LiveContent" Margin="6">
                            <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="3.4*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Sender suchen (Ebene und Transponder folgen)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="LiveChannelBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                              SelectionChanged="LiveChannelBox_SelectionChanged" KeyUp="LiveChannelBox_KeyUp"
                                              ToolTip="Namen eintippen, z.B. „ZDF“ – dann aus der Liste wählen" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Ebene" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="LivePlaneBox" SelectionChanged="LivePlaneBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Transponder (★ = Vorschlag aus der Messreihe)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="LiveTransponderBox" SelectionChanged="LiveTransponderBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="LiveStartButton" Content="▶  Live starten" Click="LiveStartButton_Click" IsEnabled="False"
                                            Style="{StaticResource AccentButton}" MinWidth="120" Margin="8,0,8,0" />
                                    <Button x:Name="LiveStopButton" Content="■  Stopp" Click="LiveStopButton_Click" IsEnabled="False"
                                            MinWidth="80" Margin="0,0,8,0" />
                                    <Button x:Name="MiniScanButton" Content="◔  Mini-Scan Ebene" Click="MiniScanButton_Click" IsEnabled="False" Margin="0,0,8,0"
                                            ToolTip="Misst bis zu 5 gleichmäßig über die Ebene verteilte Transponder und zeigt Minimum und Maximum als violetten Bogen in den Gauges" />
                                    <Button Content="Marken zurücksetzen" Click="ResetPeaksButton_Click" Margin="0,0,8,0"
                                            ToolTip="Blaue Marke = bester Wert seit dem Start (hilfreich beim Ausrichten), violetter Bogen = Bereich des Mini-Scans" />
                                    <Button x:Name="FullscreenButton" Content="⛶  Vollbild" Click="FullscreenButton_Click"
                                            ToolTip="Live-Messung im Vollbild anzeigen (F11) – Esc kehrt zurück" />
                                </StackPanel>
                                <Border x:Name="LiveLockBadge" CornerRadius="12" Padding="12,3" Background="#B0B0B0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveLockText" Text="bereit" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="LiveInfoText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="1.3*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,6,6" Padding="6"><c:GaugeControl x:Name="GaugeMer" /></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,3,6" Padding="6"><c:GaugeControl x:Name="GaugeCn" /></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,6" Padding="6"><c:GaugeControl x:Name="GaugeLevel" /></Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,6,6" Padding="6"><c:GaugeControl x:Name="GaugeQuality" /></Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,3,6" Padding="6"><c:GaugeControl x:Name="GaugeStrength" /></Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,6" Padding="6"><c:GaugeControl x:Name="GaugeBer" /></Border>
                                <c:TrafficLight x:Name="LiveLight" Grid.Row="2" Margin="0,0,6,0" VisibleReasons="3" Compact="True" VerticalAlignment="Top" />
                                <sp:WpfPlot x:Name="PlotLive" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Bereit." Style="{StaticResource Hint}" Margin="4,10,4,0" />
    </Grid>
</Window>
