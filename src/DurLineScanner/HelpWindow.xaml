<Window x:Class="DurLineScanner.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hilfe" Height="820" Width="1040" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI" FontSize="13" Icon="/Assets/app.ico">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Schließen" Click="CloseButton_Click" IsCancel="True" IsDefault="True"
                    Style="{StaticResource AccentButton}" MinWidth="110" />
            <TextBlock x:Name="FooterText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="6">
            <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
                <TabItem x:Name="GuideTab" Header="Benutzerhandbuch">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,6,4">
                            <Button x:Name="GuideLanguageButton" Click="GuideLanguageButton_Click" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Suchen: Strg+F · Zoom: Strg+Mausrad · Inhaltsverzeichnis anklicken springt zum Abschnitt" />
                        </StackPanel>
                        <FlowDocumentReader x:Name="GuideReader" ViewingMode="Scroll" IsPageViewEnabled="False"
                                            IsTwoPageViewEnabled="False" IsFindEnabled="True" Zoom="100" />
                    </DockPanel>
                </TabItem>

                <TabItem x:Name="AboutTab" Header="Über">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Image Source="/Assets/app.ico" Width="64" Height="64" />
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DUR-line Scanner" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutVersionText" FontSize="15" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Windows-Programm für das Sat-Messgerät DUR-line SF 4000 BT: Transponder-Scans, Messreihen, Pegelauswertung je Ebene, Live-Messung mit Ampel." />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"
                                       Text="Getestet nur mit einem Gerät: DUR-line SF 4000 BT („Finder S2“, Modell 260B)." />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{StaticResource TextSecondary}"
                                       Text="Kein Produkt des Geräteherstellers. Markennamen gehören ihren Inhabern." />

                            <TextBlock Text="Lizenz" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="© 2026 DUR-line Scanner contributors" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                                       Text="Freie Software unter der GNU General Public License Version 3 (GPL-3.0): Sie dürfen das Programm nutzen, weitergeben und verändern; veränderte Fassungen müssen ebenfalls unter der GPL-3.0 mit Quelltext weitergegeben werden. Es gibt keinerlei Gewährleistung. Den vollständigen Text zeigt die Registerkarte „Lizenz“." />

                            <TextBlock Text="Quelltext und Versionen" Style="{StaticResource SectionTitle}" />
                            <TextBlock Margin="0,0,0,16">
                                <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/Mephilius/DurLineScanner" RequestNavigate="Link_RequestNavigate">github.com/Mephilius/DurLineScanner</Hyperlink>
                            </TextBlock>

                            <TextBlock Text="Daten und Bibliotheken von Dritten" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Transponderliste: satellites.xml von OpenPLi (aus LyngSat-Daten erzeugt)" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Adresssuche: Nominatim – Kartendaten © OpenStreetMap-Mitwirkende (ODbL)" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Diagramme: ScottPlot (MIT-Lizenz)" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Laufzeit: .NET und WPF von Microsoft (MIT-Lizenz)" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="LicenseTab" Header="Lizenz">
                    <TextBox x:Name="LicenseBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             BorderThickness="0" Margin="4" />
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
